#!/bin/bash
#PBS -N train_array
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=24:00:00
#PBS -J 1-10
#PBS -j oe

cd $PBS_O_WORKDIR

LOGDIR=logs
mkdir -p ${LOGDIR}

N=${PBS_ARRAY_INDEX}

python clean_codes_v2/run_train_pipeline.py \
    --config-file demo_config.json \
    --train 0 \
    --N ${N} \
    --Num 10 \
    --test 0 \
    --fresh_run 0 \
    > ${LOGDIR}/${N}.log 2>&1